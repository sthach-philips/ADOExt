{
  "defaultMode": "auto",
  "mcpServers": {
    "playwright": {
      "command": "npx.cmd",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm run compile)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run watch)",
      "Bash(pnpm run check:extension)",
      "Bash(pnpm run check:webviews)",
      "Bash(pnpm install)",
      "Bash(npx @vscode/vsce package*)"
    ]
  }
}
