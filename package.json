      { "command": "adoext.setPlanningTitleFilter", "title": "Filter by Title", "category": "ADOExt", "icon": "$(search)" },
      { "command": "adoext.setPlanningGlobalFilter", "title": "Configure Global Filter", "category": "ADOExt", "icon": "$(filter)" },
      {
