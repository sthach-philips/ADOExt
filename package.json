    "menus": {
      "view/title": [
        {
          "command": "adoext.refreshWorkItems",
          "when": "view == adoext.workItems && adoext.workItems.show.refreshWorkItems",
          "group": "navigation@1"
        },
        {
          "command": "adoext.selectWorkItemQuery",
          "when": "view == adoext.workItems && adoext.workItems.show.selectWorkItemQuery",
          "group": "navigation@2"
        },
        {
          "command": "adoext.openSavedQuery",
          "when": "view == adoext.workItems && adoext.workItems.show.openSavedQuery",
          "group": "navigation@3"
        },
        {
          "command": "adoext.saveWorkItemQuery",
          "when": "view == adoext.workItems && adoext.workItems.show.saveWorkItemQuery",
          "group": "navigation@4"
        },
        {
          "command": "adoext.createWorkItem",
          "when": "view == adoext.workItems && adoext.workItems.show.createWorkItem",
          "group": "navigation@5"
        },
        {
          "command": "adoext.setWorkItemFilter",
          "when": "view == adoext.workItems && adoext.workItems.show.setWorkItemFilter",
          "group": "navigation@6"
        },
        {
          "command": "adoext.setWorkItemSort",
          "when": "view == adoext.workItems && adoext.workItems.show.setWorkItemSort",
          "group": "navigation@7"
        },
        {
          "command": "adoext.toggleHideDoneWorkItems",
          "when": "view == adoext.workItems && adoext.workItems.show.toggleHideDoneWorkItems",
          "group": "navigation@8"
        },
        {
          "command": "adoext.openBacklogView",
          "when": "view == adoext.backlog && adoext.backlog.show.openBacklogView",
          "group": "navigation@1"
        },
        {
          "command": "adoext.refreshBacklog",
          "when": "view == adoext.backlog && adoext.backlog.show.refreshBacklog",
          "group": "navigation@2"
        },
        {
          "command": "adoext.setPlanningAssignedFilter",
          "when": "view == adoext.backlog && adoext.backlog.show.setPlanningAssignedFilter",
          "group": "navigation@3"
        },
        {
          "command": "adoext.setPlanningAreaFilter",
          "when": "view == adoext.backlog && adoext.backlog.show.setPlanningAreaFilter",
          "group": "navigation@4"
        },
        {
          "command": "adoext.setPlanningTitleFilter",
          "when": "view == adoext.backlog && adoext.backlog.show.setPlanningTitleFilter",
          "group": "navigation@5"
        },
        {
          "command": "adoext.openSprintView",
          "when": "view == adoext.sprints && adoext.sprints.show.openSprintView",
          "group": "navigation@1"
        },
        {
          "command": "adoext.refreshSprints",
          "when": "view == adoext.sprints && adoext.sprints.show.refreshSprints",
          "group": "navigation@2"
        },
        {
          "command": "adoext.setPlanningAssignedFilter",
          "when": "view == adoext.sprints && adoext.sprints.show.setPlanningAssignedFilter",
          "group": "navigation@3"
        },
        {
          "command": "adoext.setPlanningIterationFilter",
          "when": "view == adoext.sprints && adoext.sprints.show.setPlanningIterationFilter",
          "group": "navigation@4"
        },
        {
          "command": "adoext.setPlanningAreaFilter",
          "when": "view == adoext.sprints && adoext.sprints.show.setPlanningAreaFilter",
          "group": "navigation@5"
        },
        {
          "command": "adoext.setPlanningTitleFilter",
          "when": "view == adoext.sprints && adoext.sprints.show.setPlanningTitleFilter",
          "group": "navigation@6"
        },
        {
          "command": "adoext.openBoardView",
          "when": "view == adoext.boards && adoext.boards.show.openBoardView",
          "group": "navigation@1"
        },
        {
          "command": "adoext.refreshBoards",
          "when": "view == adoext.boards && adoext.boards.show.refreshBoards",
          "group": "navigation@2"
        },
        {
          "command": "adoext.setPlanningAssignedFilter",
          "when": "view == adoext.boards && adoext.boards.show.setPlanningAssignedFilter",
          "group": "navigation@3"
        },
        {
          "command": "adoext.setPlanningStateFilter",
          "when": "view == adoext.boards && adoext.boards.show.setPlanningStateFilter",
          "group": "navigation@4"
        },
        {
          "command": "adoext.setPlanningAreaFilter",
          "when": "view == adoext.boards && adoext.boards.show.setPlanningAreaFilter",
          "group": "navigation@5"
        },
        {
          "command": "adoext.setPlanningTitleFilter",
          "when": "view == adoext.boards && adoext.boards.show.setPlanningTitleFilter",
          "group": "navigation@6"
        },
        {
          "command": "adoext.selectOrganization",
          "when": "view == adoext.workItems || view == adoext.backlog || view == adoext.sprints || view == adoext.boards || view == adoext.pullRequests || view == adoext.pipelines",
          "group": "navigation"
        },
        {
          "command": "adoext.detectRepoContext",
          "when": "view == adoext.workItems || view == adoext.backlog || view == adoext.sprints || view == adoext.boards || view == adoext.pullRequests || view == adoext.pipelines",
          "group": "navigation"
        },
        {
          "command": "adoext.signIn",
          "when": "(view == adoext.workItems || view == adoext.backlog || view == adoext.sprints || view == adoext.boards || view == adoext.pullRequests || view == adoext.pipelines) && !adoext.isSignedIn",
          "group": "navigation"
        },
        {
          "command": "adoext.refreshPullRequests",
          "when": "view == adoext.pullRequests",
          "group": "navigation"
        },
        {
          "command": "adoext.savePullRequestQuery",
          "when": "view == adoext.pullRequests",
          "group": "navigation"
        },
        {
          "command": "adoext.setPullRequestFilter",
          "when": "view == adoext.pullRequests",
          "group": "navigation"
        },
        {
          "command": "adoext.setPullRequestSort",
          "when": "view == adoext.pullRequests",
          "group": "navigation"
        },
        {
          "command": "adoext.toggleResolvedPullRequestThreads",
          "when": "view == adoext.pullRequests",
          "group": "navigation"
        },
        {
          "command": "adoext.refreshPipelines",
          "when": "view == adoext.pipelines",
          "group": "navigation"
        },
        {
          "command": "adoext.setPipelineRunsFilter",
          "when": "view == adoext.pipelines",
          "group": "navigation"
        },
        {
          "command": "adoext.setPipelineRunsGroupBy",
          "when": "view == adoext.pipelines",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "adoext.refreshPullRequestBucket",
          "when": "viewItem == pullRequestBucket",
          "group": "inline"
        },
        {
          "command": "adoext.viewWorkItemDetails",
          "when": "viewItem == workItem",
          "group": "inline"
        },
        {
          "command": "adoext.openWorkItem",
          "when": "viewItem == workItem",
          "group": "navigation"
        },
        {
          "command": "adoext.changeWorkItemState",
          "when": "viewItem == workItem",
          "group": "inline"
        },
        {
          "command": "adoext.startWorkingOnWorkItem",
          "when": "viewItem == workItem",
          "group": "inline"
        },
        {
          "command": "adoext.viewPullRequestDetails",
          "when": "viewItem == pullRequest",
          "group": "inline"
        },
        {
          "command": "adoext.viewPullRequestDiff",
          "when": "viewItem == pullRequest",
          "group": "inline"
        },
        {
          "command": "adoext.approvePullRequest",
          "when": "viewItem == pullRequest",
          "group": "review@1"
        },
        {
          "command": "adoext.approvePullRequestWithSuggestions",
          "when": "viewItem == pullRequest",
          "group": "review@2"
        },
        {
          "command": "adoext.waitForPullRequestAuthor",
          "when": "viewItem == pullRequest",
          "group": "review@3"
        },
        {
          "command": "adoext.rejectPullRequest",
          "when": "viewItem == pullRequest",
          "group": "review@4"
        },
        {
          "command": "adoext.resetPullRequestVote",
          "when": "viewItem == pullRequest",
          "group": "review@5"
        },
        {
          "command": "adoext.checkoutPullRequest",
          "when": "viewItem == pullRequest",
          "group": "inline"
        },
        {
          "command": "adoext.openPullRequest",
          "when": "viewItem == pullRequest",
          "group": "navigation"
        },
        {
          "command": "adoext.openPullRequestSourceBranch",
          "when": "viewItem == pullRequest",
          "group": "navigation"
        },
        {
          "command": "adoext.openPullRequestCommit",
          "when": "viewItem == pullRequest",
          "group": "navigation"
        },
        {
          "command": "adoext.replyToComment",
          "when": "viewItem == prComment",
          "group": "inline"
        },
        {
          "command": "adoext.resolveThread",
          "when": "viewItem == prCommentThreadActive",
          "group": "inline"
        },
        {
          "command": "adoext.reopenThread",
          "when": "viewItem == prCommentThreadResolved",
          "group": "inline"
        },
        {
          "command": "adoext.viewPipelineRunDetails",
          "when": "viewItem == pipelineRun || viewItem == pipelineRunRunning",
          "group": "inline"
        },
        {
          "command": "adoext.openPipelineRun",
          "when": "viewItem == pipelineRun || viewItem == pipelineRunRunning",
          "group": "navigation"
        },
        {
          "command": "adoext.openPipelineRunLogs",
          "when": "viewItem == pipelineRun || viewItem == pipelineRunRunning",
          "group": "navigation"
        },
        {
          "command": "adoext.rerunPipelineRun",
          "when": "viewItem == pipelineRun || viewItem == pipelineRunRunning",
          "group": "navigation"
        },
        {
          "command": "adoext.cancelPipelineRun",
          "when": "viewItem == pipelineRunRunning",
          "group": "navigation"
        },
        {
          "command": "adoext.openPipelineStepLog",
          "when": "viewItem == pipelineStepLog",
          "group": "inline"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "adoext.prComment.create",
          "group": "inline",
          "when": "commentController == adoext.prComments && commentThreadIsEmpty"
        },
        {
          "command": "adoext.prComment.reply",
          "group": "inline",
          "when": "commentController == adoext.prComments && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "adoext.prComment.resolve",
          "group": "inline@1",
          "when": "commentController == adoext.prComments && commentThread == prThreadActive"
        },
        {
          "command": "adoext.prComment.reopen",
          "group": "inline@1",
          "when": "commentController == adoext.prComments && commentThread == prThreadResolved"
        }
      ],
      "editor/context": [
        {
          "command": "adoext.createWorkItemFromSelection",
          "when": "editorHasSelection && adoext.isSignedIn",
          "group": "adoext@1"
        },
        {
          "command": "adoext.createWorkItemFromTodo",
          "when": "adoext.isSignedIn",
          "group": "adoext@2"
        }
      ],
      "commandPalette": [
        {
          "command": "adoext.prComment.create",
          "when": "false"
        },
        {
          "command": "adoext.prComment.reply",
          "when": "false"
        },
        {
          "command": "adoext.prComment.resolve",
          "when": "false"
        },
        {
          "command": "adoext.prComment.reopen",
          "when": "false"
        },
        {
          "command": "adoext.openWorkItemById",
          "when": "false"
        },
        {
          "command": "adoext.viewWorkItemDetailsById",
          "when": "false"
        },
        {
          "command": "adoext.openPullRequestById",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "ADOExt",
      "properties": {
        "adoext.authMethod": {
          "type": "string",
          "default": "vscode",
          "enum": [
            "vscode",
            "msal",
            "azcli",
            "pat"
          ],
          "enumDescriptions": [
            "VS Code built-in Microsoft authentication (default)",
            "MSAL interactive OAuth via local browser (works in WSL/proxy environments)",
            "Azure CLI credential (requires 'az login')",
            "Personal Access Token from AZURE_DEVOPS_PAT environment variable"
          ],
          "description": "Authentication method for Azure DevOps. Use 'msal' if VS Code auth fails in WSL/proxy setups."
        },
        "adoext.organization": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps organization name (e.g. 'mycompany' for https://dev.azure.com/mycompany)"
        },
        "adoext.project": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps project name. Kept for compatibility; use organization/project selection commands for aggregation."
        },
        "adoext.organizations": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Azure DevOps organizations selected for aggregated views."
        },
        "adoext.projectsByOrganization": {
          "type": "object",
          "default": {},
          "description": "Project selections by organization for aggregated views. Use [\"*\"] to include all projects in an organization."
        },
        "adoext.workItemQueries": {
          "type": "array",
          "default": [],
          "description": "Saved work item query definitions. When empty, ADOExt falls back to adoext.workItemQuery for compatibility.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "filter"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier for the saved work item query."
              },
              "label": {
                "type": "string",
                "description": "Label shown for the saved work item query."
              },
              "filter": {
                "type": "string",
                "enum": [
                  "assigned",
                  "created",
                  "mentioned",
                  "all"
                ],
                "description": "Built-in work item filter backing this saved query."
              },
              "description": {
                "type": "string",
                "description": "Optional description for the saved work item query."
              }
            }
          }
        },
        "adoext.activeWorkItemQueryId": {
          "type": "string",
          "default": "",
          "description": "Active saved work item query ID. When empty or invalid, ADOExt falls back to the first saved query or derives one from adoext.workItemQuery."
        },
        "adoext.workItemQuery": {
          "type": "string",
          "default": "assigned",
          "enum": [
            "assigned",
            "created",
            "mentioned",
            "all"
          ],
          "enumDescriptions": [
            "Work items assigned to me",
            "Work items created by me",
            "Work items where I was mentioned",
            "All active work items"
          ],
          "description": "Legacy default work item filter. Used when adoext.workItemQueries is empty."
        },
        "adoext.pullRequestQueries": {
          "type": "array",
          "default": [],
          "description": "Saved pull request bucket definitions. Custom buckets are appended after the built-in Pull Requests buckets.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "filter"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable identifier for the saved pull request query."
              },
              "label": {
                "type": "string",
                "description": "Label shown for the saved pull request query."
              },
              "filter": {
                "type": "string",
                "enum": [
                  "mine",
                  "created",
                  "assigned",
                  "all"
                ],
                "description": "Built-in pull request filter backing this saved query."
              },
              "description": {
                "type": "string",
                "description": "Optional description for the saved pull request query."
              }
            }
          }
        },
        "adoext.activePullRequestQueryId": {
          "type": "string",
          "default": "",
          "description": "Legacy active pull request query ID retained for backward compatibility with older extension versions."
        },
        "adoext.pullRequestFilter": {
          "type": "string",
          "default": "mine",
          "enum": [
            "mine",
            "created",
            "assigned",
            "all"
          ],
          "enumDescriptions": [
            "PRs I created or am reviewing",
            "PRs I created",
            "PRs assigned to me for review",
            "All active PRs"
          ],
          "description": "Legacy default pull request filter retained for backward compatibility with older extension versions."
        },
        "adoext.workItemFilterRegex": {
          "type": "string",
          "default": "",
          "description": "Regex pattern to filter work items by title. Leave empty to show all."
        },
        "adoext.workItemHideStates": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Work item states to hide from the Work Items tree view (e.g. [\"Done\", \"Removed\"]). Applied as a client-side filter; case-insensitive."
        },
        "adoext.useRemoteWorkItemIcons": {
          "type": "boolean",
          "default": true,
          "description": "Prefer work item type icons from Azure DevOps metadata (including custom process icons). Disable to always use bundled fallback icons."
        },
        "adoext.workItemSortOrder": {
          "type": "string",
          "default": "name",
          "enum": [
            "name",
            "date"
          ],
          "enumDescriptions": [
            "Sort work items alphabetically by title",
            "Sort work items by most recent activity"
          ],
          "description": "Sort order for work items in the ADOExt Work Items view."
        },
        "adoext.backlogFilterRegex": {
          "type": "string",
          "default": "",
          "description": "Regex pattern to filter backlog items by title. Leave empty to show all."
        },
        "adoext.backlogSortOrder": {
          "type": "string",
          "default": "name",
          "enum": [
            "name",
            "date"
          ],
          "enumDescriptions": [
            "Sort backlog items alphabetically by title",
            "Sort backlog items by most recent activity"
          ],
          "description": "Sort order for backlog items in the ADOExt Backlog view."
        },
        "adoext.planningAssignedFilter": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "mine"
          ],
          "enumDescriptions": [
            "Show all planning items",
            "Show only planning items assigned to me"
          ],
          "description": "Assignee filter applied to Backlog, Sprint, and Board views."
        },
        "adoext.pullRequestFilterRegex": {
          "type": "string",
          "default": "",
          "description": "Regex pattern to filter pull requests by title. Leave empty to show all."
        },
        "adoext.pullRequestSortOrder": {
          "type": "string",
          "default": "title",
          "enum": [
            "title",
            "date"
          ],
          "enumDescriptions": [
            "Sort pull requests alphabetically by title",
            "Sort pull requests by most recent activity"
          ],
          "description": "Sort order for pull requests in the ADOExt Pull Requests view."
        },
        "adoext.pipelineRunsFilter": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "running",
            "failed",
            "mine"
          ],
          "enumDescriptions": [
            "Show all recent runs",
            "Show only currently running or queued runs",
            "Show only failed or partially succeeded runs",
            "Show only runs requested by me"
          ],
          "description": "Filter applied to the ADOExt Pipelines view."
        },
        "adoext.pipelineRunsGroupBy": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "repository",
            "branch"
          ],
          "enumDescriptions": [
            "Show runs as a flat list",
            "Group runs by repository",
            "Group runs by branch"
          ],
          "description": "Optional grouping applied under each project scope in the ADOExt Pipelines view."
        },
        "adoext.pipelineRunsTop": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of pipeline runs fetched per project scope for the ADOExt Pipelines view."
        },
        "adoext.workItemQueryLimit": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum work items fetched per scope for the Work Items view (WIQL query limit)."
        },
        "adoext.planningQueryLimit": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum work items per WIQL query for Backlog, Sprint, and Board views."
        },
        "adoext.planningTotalLimit": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "maximum": 5000,
          "description": "Hard cap on total work items including recursively fetched parents for planning views."
        },
        "adoext.completionWorkItemLimit": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 200,
          "description": "Maximum work items loaded for inline #id completion suggestions."
        },
        "adoext.buildsPerQuery": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum builds fetched per pull request or work item artifact link."
        },
        "adoext.pullRequestLimit": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum pull requests fetched per scope."
        },
        "adoext.workItemTypeSchemaCacheTtlMinutes": {
          "type": "number",
          "default": 240,
          "minimum": 30,
          "maximum": 1440,
          "description": "TTL in minutes for the work item type schema cache (types, fields, states). Longer values reduce API calls."
        },
        "adoext.workItemIconCacheTtlMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 1440,
          "description": "TTL in minutes for cached work item type icon URLs."
        },
        "adoext.classificationNodeDepth": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 20,
          "description": "Depth of area/iteration path tree fetched for filter QuickPicks."
        },
        "adoext.savedQueryFolderDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 5,
          "description": "Depth of saved query folder traversal."
        },
        "adoext.pipelineTimelineCacheSize": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 1000,
          "description": "Maximum entries in the in-memory pipeline timeline cache."
        },
        "adoext.scopeFetchConcurrency": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 10,
          "description": "Number of parallel organization/project scope fetches."
        },
        "adoext.workItemBatchSize": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "maximum": 200,
          "description": "Items fetched per Azure DevOps batch API call (max 200 is the API constraint)."
        },
        "adoext.fuzzySearchThreshold": {
          "type": "number",
          "default": 0.4,
          "minimum": 0,
          "maximum": 1,
          "description": "Fuse.js threshold for fuzzy title search. 0 = exact match only, 1 = match anything."
        },
        "adoext.planningViews": {
          "type": "object",
          "markdownDescription": "Configuration for planning view filters, sections, and toolbar buttons. Use the guided commands (Filter by Area/Iteration/Title/Type) for easy editing, or edit directly. See [settings reference](docs/settings.example.jsonc).",
          "default": {
            "global": {
              "assignedFilter": "all",
              "areaFilter": "",
              "iterationFilter": "",
              "titleFilter": "",
              "typeFilter": [],
              "showUnmatchedStates": true
            },
            "workItems": { "sections": [], "actions": ["adoext.refreshWorkItems", "adoext.selectWorkItemQuery", "adoext.openSavedQuery", "adoext.saveWorkItemQuery", "adoext.createWorkItem", "adoext.setWorkItemFilter", "adoext.setWorkItemSort", "adoext.toggleHideDoneWorkItems"] },
            "backlog": { "sections": [], "actions": ["adoext.openBacklogView", "adoext.refreshBacklog", "adoext.setPlanningAssignedFilter", "adoext.setPlanningAreaFilter", "adoext.setPlanningTitleFilter"] },
            "sprints": { "sections": [], "actions": ["adoext.openSprintView", "adoext.refreshSprints", "adoext.setPlanningAssignedFilter", "adoext.setPlanningIterationFilter", "adoext.setPlanningAreaFilter", "adoext.setPlanningTitleFilter"] },
            "boards": { "sections": [], "actions": ["adoext.openBoardView", "adoext.refreshBoards", "adoext.setPlanningAssignedFilter", "adoext.setPlanningStateFilter", "adoext.setPlanningAreaFilter", "adoext.setPlanningTitleFilter"] }
          },
          "properties": {
            "global": {
              "type": "object",
              "properties": {
                "assignedFilter": { "type": "string", "enum": ["all", "mine"] },
                "areaFilter": { "type": "string" },
                "iterationFilter": { "type": "string" },
                "titleFilter": { "type": "string" },
                "typeFilter": { "type": "array", "items": { "type": "string" } },
                "showUnmatchedStates": { "type": "boolean" }
              }
            },
            "workItems": { "$ref": "#/properties/adoext.planningViews/definitions/viewConfig" },
            "backlog": { "$ref": "#/properties/adoext.planningViews/definitions/viewConfig" },
            "sprints": { "$ref": "#/properties/adoext.planningViews/definitions/viewConfig" },
            "boards": { "$ref": "#/properties/adoext.planningViews/definitions/viewConfig" }
          },
          "definitions": {
            "viewConfig": {
              "type": "object",
              "properties": {
                "assignedFilter": { "type": "string", "enum": ["all", "mine"] },
                "areaFilter": { "type": "string" },
                "iterationFilter": { "type": "string" },
                "titleFilter": { "type": "string" },
                "typeFilter": { "type": "array", "items": { "type": "string" } },
                "showUnmatchedStates": { "type": "boolean" },
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "label", "stateFilter", "order"],
                    "properties": {
                      "id": { "type": "string" },
                      "label": { "type": "string" },
                      "stateFilter": { "type": "array", "items": { "type": "string" } },
                      "order": { "type": "number" },
                      "collapsed": { "type": "boolean" }
                    }
                  }
                },
                "actions": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "adoext.showResolvedPullRequestThreads": {
          "type": "boolean",
          "default": true,
          "description": "Show resolved pull request comment threads in tree and details views."
        },
        "adoext.hideSystemPullRequestThreads": {
          "type": "boolean",
          "default": true,
          "description": "Hide system-generated PR threads (e.g. ref-update notifications from Microsoft.VisualStudio.Services.TFS). These threads are not visible in the Azure DevOps web UI either."
        },
        "adoext.notifyOnNewPullRequestComments": {
          "type": "boolean",
          "default": true,
          "description": "Show a small notification when new comments appear on tracked pull requests. Disable to silence the toasts."
        },
        "adoext.notifyOnPullRequestReviewRequests": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when you are added as a reviewer on a pull request."
        },
        "adoext.notifyOnPullRequestStatusChanges": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a reviewer votes on a pull request you created."
        },
        "adoext.pullRequestCommentPollIntervalSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 60,
          "description": "How often (in seconds) ADOExt polls tracked pull requests for notifications. Ignored when all notifications are disabled."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "pnpm run check:extension && pnpm run compile:host && pnpm run check:webviews && pnpm run compile:webviews",
    "check:extension": "tsc -p ./ --noEmit",
    "compile:host": "node ./scripts/build-extension-host.js",
    "compile:webviews": "node ./scripts/build-webviews.js",
    "check:webviews": "tsc -p ./tsconfig.webviews.json --noEmit",
    "watch": "node ./scripts/build-extension-host.js --watch",
    "watch:types": "tsc -watch -p ./ --noEmit",
    "watch:host": "node ./scripts/build-extension-host.js --watch",
    "watch:webviews": "node ./scripts/build-webviews.js --watch",
    "lint": "eslint src --ext ts --max-warnings=0",
    "test:compat": "node tests/bundle-compat/lowdb-cjs.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@types/node": "20.19.43",
    "@types/vscode": "1.101.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "lit": "3.3.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@azure/identity": "4.13.2",
    "@azure/msal-node": "5.5.0",
    "azure-devops-node-api": "15.1.3",
    "fuse.js": "^7.0.0",
    "lowdb": "^7.0.1",
    "open": "11.0.1"
  }
}
