{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx.cmd", "-y", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "pnpm run compile": "allow",
      "pnpm run lint": "allow",
      "pnpm run watch": "allow",
      "pnpm run check:extension": "allow",
      "pnpm run check:webviews": "allow",
      "pnpm install": "allow",
      "npx @vscode/vsce package*": "allow",
      "*": "ask"
    }
  }
}
